# Server Environment Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (Supabase PostgreSQL)
# Connection Pooling URL (Transaction mode on port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct URL for migrations (Session mode on port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API Credentials
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# JWT Configuration (for standalone / local token generation fallback)
JWT_SECRET="replace-with-a-very-secure-random-secret-key-at-least-32-chars"
JWT_EXPIRES_IN="8h"

# Default Administrator Seed
ADMIN_EMAIL="admin@excelinsight.local"
ADMIN_PASSWORD="ChangeThisStrongPassword123!"
ADMIN_FULL_NAME="System Administrator"
